# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here-generate-with-python-secrets
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database Configuration
# For development (SQLite)
DATABASE_URI=sqlite:///bankstatements_saas.db

# For production (PostgreSQL)
# DATABASE_URI=postgresql://username:password@localhost:5432/bankstatements_saas

SQLALCHEMY_TRACK_MODIFICATIONS=False

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=pdf,csv,xlsx,xls,ofx,qfx

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# External Tools Configuration (for PDF OCR processing)
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin

# Linux/Mac example:
# TESSERACT_CMD=/usr/bin/tesseract
# POPPLER_PATH=/usr/bin

TESSERACT_CMD=
POPPLER_PATH=

# Rate Limiting Configuration
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_DEFAULT=10 per minute

# File Cleanup Configuration
FILE_CLEANUP_HOURS=1

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log

# Stripe Configuration (REQUIRED for payments)
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret
# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create products in Stripe Dashboard)
# Create recurring price items for each tier
STRIPE_PRICE_ID_STARTER=price_starter_monthly
STRIPE_PRICE_ID_PROFESSIONAL=price_professional_monthly
STRIPE_PRICE_ID_BUSINESS=price_business_monthly

# Production Performance (Optional - for scaling)
REDIS_URL=redis://localhost:6379/0
SENTRY_DSN=

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@bankstatementai.com

# AWS S3 Configuration (Optional - for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Application URLs
APP_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000/api

# Feature Flags
ENABLE_API=False
ENABLE_BATCH_PROCESSING=False
ENABLE_WEBHOOKS=False

# Security
BCRYPT_LOG_ROUNDS=12
PASSWORD_MIN_LENGTH=8
SESSION_PROTECTION=strong

# Rate Limits (requests per time period)
RATE_LIMIT_CONVERSION=20 per minute
RATE_LIMIT_API=100 per hour
RATE_LIMIT_LOGIN=5 per minute

# Monitoring
ENABLE_MONITORING=False
ENABLE_ANALYTICS=False
